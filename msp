REPORT zminesweeper.

*----------------------------------------------------------------------*
* Data Types & Global Variables
*----------------------------------------------------------------------*
TYPES: BEGIN OF ty_cell,
         row_id TYPE i,
         c1     TYPE string, c2 TYPE string, c3 TYPE string, c4 TYPE string,
         c5     TYPE string, c6 TYPE string, c7 TYPE string, c8 TYPE string,
       END OF ty_cell.

DATA: gt_display_board TYPE STANDARD TABLE OF ty_cell,
      gt_logic_board   TYPE STANDARD TABLE OF ty_cell,
      gv_mines_count   TYPE i VALUE 10,
      gv_game_over     TYPE flag,
      gv_dim           TYPE i VALUE 8. " 8x8 Grid

" ALV Grid Grid Display Objects
DATA: go_container TYPE REF TO cl_gui_custom_container,
      go_grid      TYPE REF TO cl_gui_alv_grid,
      gt_fieldcat  TYPE lvc_t_fcat.

*----------------------------------------------------------------------*
* Local Event Handler Class Definition
*----------------------------------------------------------------------*
CLASS lcl_event_handler DEFINITION.
  PUBLIC SECTION.
    METHODS: handle_hotspot_click
      FOR EVENT hotspot_click OF cl_gui_alv_grid
      IMPORTING e_row_id e_column_id.
ENDCLASS.

DATA: go_handler TYPE REF TO lcl_event_handler.

*----------------------------------------------------------------------*
* START-OF-SELECTION (Main Program Entry)
*----------------------------------------------------------------------*
START-OF-SELECTION.
  PERFORM initialize_boards.
  PERFORM place_random_mines.
  PERFORM calculate_numbers.
  CALL SCREEN 0100.

*----------------------------------------------------------------------*
* Screen PBO Module
*----------------------------------------------------------------------*
MODULE status_0100 OUTPUT.
  SET PF-STATUS 'SPACE'. " Standard blank GUI status or create one
  IF go_grid IS INITIAL.
    PERFORM build_field_catalog.
    
    CREATE OBJECT go_container EXPORTING container_name = 'GRID_CONTAINER'.
    CREATE OBJECT go_grid EXPORTING i_parent = go_container.
    
    CREATE OBJECT go_handler.
    SET HANDLER go_handler->handle_hotspot_click FOR go_grid.

    DATA(ls_layout) = VALUE lvc_s_layo( cwidth_opt = 'X' no_headers = 'X' ).

    go_grid->set_table_for_first_display(
      EXPORTING is_layout       = ls_layout
      CHANGING  it_outtab       = gt_display_board
                it_fieldcatalog = gt_fieldcat ).
  ENDIF.
ENDMODULE.

*----------------------------------------------------------------------*
* Screen PAI Module
*----------------------------------------------------------------------*
MODULE user_command_0100 INPUT.
  IF sy-ucomm = 'BACK' OR sy-ucomm = 'EXIT'.
    LEAVE PROGRAM.
  ENDIF.
ENDMODULE.

*----------------------------------------------------------------------*
* Subroutines (Core Game Mechanics Logic)
*----------------------------------------------------------------------*

FORM initialize_boards.
  CLEAR: gt_display_board, gt_logic_board, gv_game_over.
  DO gv_dim TIMES.
    " Fill with closed cell placeholder icon (@7X@ is a small square block)
    DATA(ls_cell) = VALUE ty_cell( row_id = sy-index 
      c1 = '@7X@' c2 = '@7X@' c3 = '@7X@' c4 = '@7X@'
      c5 = '@7X@' c6 = '@7X@' c7 = '@7X@' c8 = '@7X@' ).
    APPEND ls_cell TO gt_display_board.
    
    " Clean structural slate for logical tracking
    CLEAR: ls_cell-c1, ls_cell-c2, ls_cell-c3, ls_cell-c4, 
           ls_cell-c5, ls_cell-c6, ls_cell-c7, ls_cell-c8.
    APPEND ls_cell TO gt_logic_board.
  ENDDO.
ENDFORM.

FORM place_random_mines.
  DATA: lv_rand_row TYPE i, lv_rand_col TYPE i,
        lv_placed   TYPE i VALUE 0,
        lo_rand     TYPE REF TO cl_abap_random_int.

  lo_rand = cl_abap_random_int=>create( seed = cl_abap_random=>seed( ) min = 1 max = gv_dim ).

  WHILE lv_placed < gv_mines_count.
    lv_rand_row = lo_rand->get_next( ).
    lv_rand_col = lo_rand->get_next( ).

    READ TABLE gt_logic_board ASSIGNING FIELD-SYMBOL(<ls_row>) INDEX lv_rand_row.
    IF sy-subrc = 0.
      ASSIGN COMPONENT ( lv_rand_col + 1 ) OF STRUCTURE <ls_row> TO FIELD-SYMBOL(<lv_field>).
      IF <lv_field> IS ASSIGNED AND <lv_field> <> 'M'.
        <lv_field> = 'M'. " Place Mine
        lv_placed = lv_placed + 1.
      ENDIF.
    ENDIF.
  ENDWHILE.
ENDFORM.

FORM calculate_numbers.
  " Loop through coordinates calculating neighboring fields
  DO gv_dim TIMES.
    DATA(lv_r) = sy-index.
    DO gv_dim TIMES.
      DATA(lv_c) = sy-index.
      
      PERFORM get_cell_value USING lv_r lv_c CHANGING DATA(lv_val).
      IF lv_val = 'M'. CONTINUE. ENDIF.

      DATA(lv_mines_found) = 0.
      " Search all 8 directions around the tracking position
      DO 3 TIMES.
        DATA(lv_dr) = lv_r + ( sy-index - 2 ).
        DO 3 TIMES.
          DATA(lv_dc) = lv_c + ( sy-index - 2 ).
          PERFORM get_cell_value USING lv_dr lv_dc CHANGING DATA(lv_n_val).
          IF lv_n_val = 'M'. lv_mines_found = lv_mines_found + 1. ENDIF.
        DO END.
      DO END.

      IF lv_mines_found > 0.
        PERFORM set_cell_value USING lv_r lv_c lv_mines_found.
      ENDIF.
    ENDDO.
  ENDDO.
ENDFORM.

FORM get_cell_value USING pv_r TYPE i pv_c TYPE i CHANGING pv_val TYPE string.
  CLEAR pv_val.
  IF pv_r < 1 OR pv_r > gv_dim OR pv_c < 1 OR pv_c > gv_dim. RETURN. ENDIF.
  READ TABLE gt_logic_board ASSIGNING FIELD-SYMBOL(<ls_row>) INDEX pv_r.
  IF sy-subrc = 0.
    ASSIGN COMPONENT ( pv_c + 1 ) OF STRUCTURE <ls_row> TO FIELD-SYMBOL(<lv_f>).
    IF sy-subrc = 0. pv_val = <lv_f>. ENDIF.
  ENDIF.
ENDFORM.

FORM set_cell_value USING pv_r TYPE i pv_c TYPE i pv_val TYPE any.
  READ TABLE gt_logic_board ASSIGNING FIELD-SYMBOL(<ls_row>) INDEX pv_r.
  IF sy-subrc = 0.
    ASSIGN COMPONENT ( pv_c + 1 ) OF STRUCTURE <ls_row> TO FIELD-SYMBOL(<lv_f>).
    IF sy-subrc = 0. <lv_f> = pv_val. ENDIF.
  ENDIF.
ENDFORM.

FORM build_field_catalog.
  DATA: ls_fcat TYPE lvc_s_fcat.
  DO gv_dim TIMES.
    CLEAR ls_fcat.
    ls_fcat-fieldname = |C{ sy-index }|.
    ls_fcat-ref_table = 'GT_DISPLAY_BOARD'.
    ls_fcat-hotspot   = 'X'. " Turns cells into clickable elements
    APPEND ls_fcat TO gt_fieldcat.
  ENDDO.
ENDFORM.

*----------------------------------------------------------------------*
* Dynamic Cascading Logic (Clearing Blank Slots Natively)
*----------------------------------------------------------------------*
FORM reveal_cell USING pv_r TYPE i pv_c TYPE i.
  IF pv_r < 1 OR pv_r > gv_dim OR pv_c < 1 OR pv_c > gv_dim. RETURN. ENDIF.

  " Verify if target cell was already checked / cleared
  READ TABLE gt_display_board ASSIGNING FIELD-SYMBOL(<ls_disp>) INDEX pv_r.
  ASSIGN COMPONENT ( pv_c + 1 ) OF STRUCTURE <ls_disp> TO FIELD-SYMBOL(<lv_d_val>).
  IF <lv_d_val> <> '@7X@'. RETURN. ENDIF. " Already opened

  PERFORM get_cell_value USING pv_r pv_c CHANGING DATA(lv_logic_val).

  IF lv_logic_val IS INITIAL.
    <lv_d_val> = ' '. " Empty revealed slot
    
    " Cascade Trigger: Recursively expand outward to clear zero arrays
    DO 3 TIMES.
      DATA(lv_dr) = pv_r + ( sy-index - 2 ).
      DO 3 TIMES.
        DATA(lv_dc) = pv_c + ( sy-index - 2 ).
        PERFORM reveal_cell USING lv_dr lv_dc.
      DO END.
    DO END.
  ELSE.
    <lv_d_val> = lv_logic_val. " Update board matrix layout with number value
  ENDIF.
ENDFORM.

*----------------------------------------------------------------------*
* Interactive Grid Click Interception Implementation
*----------------------------------------------------------------------*
CLASS lcl_event_handler IMPLEMENTATION.
  METHOD handle_hotspot_click.
    IF gv_game_over = 'X'. RETURN. ENDIF.

    DATA(lv_row) = e_row_id-row_id.
    DATA(lv_col) = VALUE i( ).
    " Convert alphanumeric column name tracking references ('C1' -> 1)
    lv_col = substring( val = e_column_id-fieldname off = 1 ).

    PERFORM get_cell_value USING lv_row lv_col CHANGING DATA(lv_hit).

    IF lv_hit = 'M'.
      " Boom! Player hit a hidden mine
      gv_game_over = 'X'.
      LOOP AT gt_display_board ASSIGNING FIELD-SYMBOL(<ls_d_row>).
        DATA(lv_r_idx) = sy-tabix.
        DO gv_dim TIMES.
          DATA(lv_c_idx) = sy-index.
          PERFORM get_cell_value USING lv_r_idx lv_c_idx CHANGING DATA(lv_m_check).
          IF lv_m_check = 'M'.
            ASSIGN COMPONENT ( lv_c_idx + 1 ) OF STRUCTURE <ls_d_row> TO FIELD-SYMBOL(<lv_f>).
            <lv_f> = '@0A@'. " Red light/bomb indicator icon output
          ENDIF.
        DO END.
      ENDLOOP.
      go_grid->refresh_table_display( ).
      MESSAGE 'Boom! Game Over. You hit a mine.' TYPE 'I' DISPLAY LIKE 'E'.
    ELSE.
      " Process path trace mapping
      PERFORM reveal_cell USING lv_row lv_col.
      go_grid->refresh_table_display( ).
      
      " Evaluate programmatic remaining criteria mapping for victory loop
      DATA(lv_closed_count) = 0.
      LOOP AT gt_display_board INTO DATA(ls_d_row).
        DO gv_dim TIMES.
          ASSIGN COMPONENT ( sy-index + 1 ) OF STRUCTURE ls_d_row TO FIELD-SYMBOL(<lv_c>).
          IF <lv_c> = '@7X@'. lv_closed_count = lv_closed_count + 1. ENDIF.
        DO END.
      ENDLOOP.

      IF lv_closed_count = gv_mines_count.
        gv_game_over = 'X'.
        MESSAGE 'Congratulations! You safely cleared the minefield!' TYPE 'I'.
      ENDIF.
    ENDIF.
  ENDMETHOD.
ENDCLASS.
